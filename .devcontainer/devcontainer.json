{
  "name": "Lohan 29er Season Hub",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "29er Season Hub",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "nohup npm run dev -- --hostname 0.0.0.0 >/tmp/29er-season-hub.log 2>&1 &",
  "remoteUser": "node"
}
